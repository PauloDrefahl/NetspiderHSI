# Only put project-specific paths in here.
# If you have OS-specific or editor-specific paths to ignore, such as '*.swp',
# '[Dd]esktop.ini', '.DS_Store', or '.vscode', put those in your global
# .gitignore file or in /path/to/repository/.git/info/exclude. Thanks!

# Ignore files that we previously used for dynamic port selection. Since commit
# 0239bbef700, NetSpider uses a fixed port, but we'll keep these patterns around
# for some time to stop people from accidentally re-committing those files.
/client/open_ports.txt
/server/open_ports.txt

# Python-generated files
__pycache__/
*.py[oc]
build/
build-*/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/

# PyInstaller
*.manifest
*.spec

# Node.js dependencies
node_modules/

# SeleniumBase
downloaded_files/

# Results folder
result/
results/

# Results folder index/cache
folders.json
